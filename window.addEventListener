<body>

<div class="topbar">
  <div class="topbar-inner">
    <div>
      <div class="brand-kicker">美食探索指南</div>
      <div class="brand-name">尋味</div>
      <div class="brand-tagline">附近的精彩，一指探索</div>
    </div>
    <div class="topbar-r">
      <div class="api-dot" id="apiDot"></div>
      <button class="icon-btn" onclick="showFavPanel()">🔖</button>
      <button class="icon-btn" onclick="toggleTheme()" id="themeBtn">🌙</button>
      <button class="icon-btn" onclick="showApiModal()">⚙️</button>
    </div>
  </div>
</div>

<div class="scroll-area">

  <!-- Session history -->
  <div class="history-strip" id="historyStrip" style="display:none">
    <div class="history-hdr">
      <span class="history-title">本次瀏覽紀錄</span>
      <button class="history-clear" onclick="clearHistory()">清除</button>
    </div>
    <div class="history-scroll" id="historyScroll"></div>
  </div>

  <!-- Filter panel -->
  <div class="filter-panel">

    <!-- Location -->
    <div class="fp-row">
      <div class="fp-label">所在位置</div>
      <div class="search-hist-wrap">
        <div style="display:flex;gap:7px;">
          <input class="m-input" style="flex:1;margin-bottom:0;height:40px;" id="locationInput" type="text" placeholder="地址、地標、捷運站..."
            oninput="onLocInput()" onfocus="showSearchHist()" onblur="setTimeout(hideSearchHist,200)"/>
          <button style="height:40px;padding:0 13px;background:var(--gold-l);border:1px solid var(--gold-b);border-radius:2px;color:var(--gold);font-size:12px;font-weight:500;font-family:'Noto Sans TC',sans-serif;cursor:pointer;white-space:nowrap;" onclick="locateMe()" id="locBtn">📍 定位</button>
        </div>
        <div class="search-hist-list" id="searchHistList"></div>
      </div>
    </div>

    <!-- Time -->
    <div class="fp-row">
      <div class="fp-label">用餐時段</div>
      <div class="chips" id="typeChips">
        <button class="chip" data-v="all"       onclick="toggleChip(this,'type')">全部</button>
        <button class="chip" data-v="breakfast" onclick="toggleChip(this,'type')">🌅 早餐</button>
        <button class="chip" data-v="brunch"    onclick="toggleChip(this,'type')">☀️ 早午餐</button>
        <button class="chip" data-v="lunch"     onclick="toggleChip(this,'type')">🌤 午餐</button>
        <button class="chip" data-v="afternoon" onclick="toggleChip(this,'type')">🍰 下午茶</button>
        <button class="chip" data-v="cafe"      onclick="toggleChip(this,'type')">☕ 咖啡廳</button>
        <button class="chip" data-v="dinner"    onclick="toggleChip(this,'type')">🌙 晚餐</button>
        <button class="chip" data-v="supper"    onclick="toggleChip(this,'type')">🌃 消夜</button>
      </div>
    </div>

    <!-- Cuisine -->
    <div class="fp-row">
      <div class="fp-label">料理類型</div>
      <div class="chips" id="cuisineChips">
        <button class="chip" data-v="all"              onclick="toggleChip(this,'cuisine')">全部</button>
        <button class="chip" data-v="chinese"          onclick="toggleChip(this,'cuisine')">🥢 中式</button>
        <button class="chip" data-v="western"          onclick="toggleChip(this,'cuisine')">🍳 西式</button>
        <button class="chip" data-v="western_american" onclick="toggleChip(this,'cuisine')">🍔 美式</button>
        <button class="chip" data-v="japanese"         onclick="toggleChip(this,'cuisine')">🍱 日式</button>
        <button class="chip" data-v="thai"             onclick="toggleChip(this,'cuisine')">🌶 泰式</button>
        <button class="chip" data-v="korean"           onclick="toggleChip(this,'cuisine')">🥘 韓式</button>
        <button class="chip" data-v="cafe"             onclick="toggleChip(this,'cuisine')">☕ 咖啡廳</button>
      </div>
    </div>

    <!-- Price -->
    <div class="fp-row">
      <div class="fp-label">價位範圍</div>
      <div style="display:flex;gap:5px;flex-wrap:wrap;">
        <button class="price-chip" data-p="-1" onclick="togglePrice(this)">不限</button>
        <button class="price-chip" data-p="1"  onclick="togglePrice(this)">$ 平價</button>
        <button class="price-chip" data-p="2"  onclick="togglePrice(this)">$$ 中價</button>
        <button class="price-chip" data-p="3"  onclick="togglePrice(this)">$$$ 較貴</button>
        <button class="price-chip" data-p="4"  onclick="togglePrice(this)">$$$$ 高級</button>
      </div>
    </div>

    <!-- Advanced -->
    <div class="fp-row">
      <div class="fp-label">進階設定</div>
      <div class="sl-row">
        <label>搜尋範圍</label>
        <input type="range" min="200" max="5000" step="100" value="1000" id="radiusSlider" oninput="updateRadius(this.value)"/>
        <span class="sl-val" id="rv">1.0 km</span>
      </div>
      <div class="inline-row" style="margin-bottom:8px;">
        <label>最低評分</label>
        <div class="mini-btns">
          <button class="mini-btn"    onclick="setRating(0,this)">不限</button>
          <button class="mini-btn on" onclick="setRating(3.5,this)">3.5★+</button>
          <button class="mini-btn"    onclick="setRating(4.0,this)">4.0★+</button>
          <button class="mini-btn"    onclick="setRating(4.5,this)">4.5★+</button>
        </div>
      </div>
      <div class="inline-row" style="margin-bottom:8px;">
        <label>排序方式</label>
        <div class="mini-btns">
          <button class="mini-btn on" data-s="dist"    onclick="setSort(this)">📍 距離</button>
          <button class="mini-btn"    data-s="rating"  onclick="setSort(this)">⭐ 評分</button>
          <button class="mini-btn"    data-s="reviews" onclick="setSort(this)">💬 評論</button>
        </div>
      </div>
      <div class="inline-row">
        <label style="min-width:0">只看</label>
        <div class="toggle-row" onclick="toggleOpenOnly()">
          <div class="toggle-track" id="openToggle"><div class="toggle-thumb"></div></div>
          <span class="toggle-label">現在營業中</span>
        </div>
      </div>
    </div>
  </div>

  <div class="results-area" id="results"></div>
</div>

<!-- Spinner FAB -->
<button class="spinner-fab" id="spinnerFab" onclick="showSpinModal()">
  🎯<span class="spinner-fab-count" id="spinCount">0</span>
</button>

