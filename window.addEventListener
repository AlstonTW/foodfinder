  document.getElementById('spinListItems').innerHTML=items.map((item,i)=>`
    <div class="spin-item">
      <div class="spin-item-dot" style="background:${WHEEL_COLORS[i%WHEEL_COLORS.length]}"></div>
      <span class="spin-item-name">${item.name}</span>
      <span class="spin-item-score">${item.rating?'★'+item.rating.toFixed(1):''}</span>
    </div>`).join('');
}

let spinVelocity=0,spinTarget=0;
function startSpin(){
  if(spinning)return;
  spinning=true;
  document.getElementById('spinResult').classList.remove('show');
  const items=[...spinSelected.values()];
  // pick random winner
  const winnerIdx=Math.floor(Math.random()*items.length);
  const slice=(2*Math.PI)/items.length;
  // target angle: pointer (top = -π/2) lands on winner slice center
  const winnerCenter=winnerIdx*slice+slice/2;
  const extra=Math.PI*2*5; // 5 full rotations
  spinTarget=spinAngle+extra+((-Math.PI/2)-winnerCenter-spinAngle%(Math.PI*2)+Math.PI*2)%(Math.PI*2);
  spinVelocity=0.35;
  animateSpin(items,winnerIdx);
}

function animateSpin(items,winnerIdx){
  const diff=spinTarget-spinAngle;
  if(diff<0.01){
    spinning=false;spinAngle=spinTarget;drawWheel(spinAngle);
    showWinner(items[winnerIdx]);return;
  }
  const ease=Math.min(diff*0.06,0.35);
  spinAngle+=ease;
  drawWheel(spinAngle);
  animFrame=requestAnimationFrame(()=>animateSpin(items,winnerIdx));
}

function showWinner(item){
  const el=document.getElementById('spinResult');
  document.getElementById('spinResultName').textContent=item.name;
  document.getElementById('spinResultMeta').textContent=(item.rating?'★'+item.rating.toFixed(1)+' · ':'')+item.ci.label;
  const navBtn=document.getElementById('spinNavBtn');
  navBtn.onclick=()=>window.open(`https://www.google.com/maps/dir/?api=1&destination=${item.lat},${item.lng}`,'_blank');
  el.classList.add('show');
  // haptic if available
  if(navigator.vibrate)navigator.vibrate([100,50,100]);
}

function spinAgain(){document.getElementById('spinResult').classList.remove('show');startSpin();}

// ══ DETAIL ══
function openDetail(card){
  const p=card._place,pk=card._pk,photos=card._photos,d=card._dist,ci=card._ci||C.other;
  const mapsUrl=`https://www.google.com/maps/place/?q=place_id:${p.place_id}`;
  const navUrl=`https://www.google.com/maps/dir/?api=1&destination=${p.geometry.location.lat()},${p.geometry.location.lng()}`;
  const ps=priceStr(p.price_level);

  // add to session history
  addSessionHistory(p,ci);

  const photoHtml=photos.length>0
    ?`<div class="d-photo-wrap"><img id="dp-img" src="${photos[0].getUrl({maxWidth:800,maxHeight:400})}" alt="照片"/><div class="d-photo-grad"></div><button class="d-close" onclick="closeDetail()">✕</button><div class="d-arr-wrap"><button class="d-arr" id="dp-prev" style="display:none" onclick="dpNav(-1)">‹</button><button class="d-arr" id="dp-next" style="display:none" onclick="dpNav(1)">›</button></div><div class="d-photo-cnt" id="dp-cnt" style="display:none"></div></div>`
    :`<div class="d-photo-wrap"><div class="d-no-photo"><span>${ci.emoji}</span><span style="font-size:13px">暫無照片</span></div><button class="d-close" onclick="closeDetail()">✕</button></div>`;

  let pkHtml='<div style="font-size:13px;color:var(--text3)">附近未找到停車場</div>';
  if(pk){const pkNav=`https://www.google.com/maps/dir/?api=1&destination=${pk.lat},${pk.lng}`;pkHtml=`<div class="pk-block"><div class="pk-name">🅿️ ${pk.name}</div><div class="pk-info">📍 ${pk.vicinity}${pk.rating?`<br>⭐ ${pk.rating.toFixed(1)}`:''}　🚶 距此餐廳 ${fmtDist(pk.dist)}</div><button class="pk-nav-btn" onclick="window.open('${pkNav}','_blank')">▶ 導航至停車場</button></div>`;}

  document.getElementById('detailContent').innerHTML=`
    ${photoHtml}
    <div class="d-body">
      <div class="d-kicker">${ci.emoji} ${ci.label}${ps?' · '+ps:''} · ${fmtDist(d)}</div>
      <div class="d-name">${p.name}</div>
      <div class="d-score-row">
        ${p.rating?`<span class="d-score">★ ${p.rating.toFixed(1)}</span>`:''}
        ${p.user_ratings_total?`<span class="d-rev-ct">${p.user_ratings_total.toLocaleString()} 則評論</span>`:''}
        ${ps?`<span class="d-price-tag">${ps} ${PRICE_TEXT[p.price_level]||''}</span>`:''}
        <span class="d-open-badge" id="d-open-badge"></span>
      </div>
      <div id="d-hours-box" style="display:none" class="d-hours-box"></div>
      <div class="d-divider"></div>
      <div class="d-sec">地址</div>
      <div class="d-addr-row"><div class="d-addr-text" id="d-addr">${p.vicinity||'載入中...'}</div><button class="d-copy-btn" onclick="copyAddr()">📋</button></div>
      <div class="d-action-row">
        <button class="d-sm-btn" onclick="sharePlace('${p.name.replace(/'/g,"\\'")}','${mapsUrl}')">📤 分享</button>
        <div id="d-phone-wrap" style="flex:1;display:flex;"></div>
      </div>
      <div class="d-divider"></div>
      <div class="d-sec">停車場</div>${pkHtml}
      <div class="d-divider"></div>
      <div class="d-sec">用戶評論（最新優先）</div>
      <div id="d-reviews"><div style="font-size:13px;color:var(--text3);font-style:italic;padding:8px 0">評論載入中...</div></div>
      <div class="d-actions">
        <button class="d-act" onclick="window.open('${mapsUrl}','_blank')">🗺 地圖</button>
        <button class="d-act primary" onclick="window.open('${navUrl}','_blank')">▶ 導航前往</button>
      </div>
    </div>`;

  dpPhotos=photos;dpIdx=0;
  document.getElementById('detailBg').classList.add('show');
  document.getElementById('detailSheet').scrollTop=0;

  placesService.getDetails({placeId:p.place_id,fields:['formatted_address','opening_hours','reviews','photos','formatted_phone_number'],language:'zh-TW'},(det,st)=>{
    if(st!=='OK'||!det)return;
    if(det.formatted_address){const el=document.getElementById('d-addr');if(el)el.textContent=det.formatted_address.replace(/^台灣/,'').trim();}
    if(det.formatted_phone_number){const pw=document.getElementById('d-phone-wrap');if(pw)pw.innerHTML=`<button class="d-sm-btn green" style="width:100%" onclick="window.open('tel:${det.formatted_phone_number}','_self')">📞 ${det.formatted_phone_number}</button>`;}
    if(det.opening_hours){
      const open=isOpenNow(det.opening_hours);
      const badge=document.getElementById('d-open-badge');
      if(badge&&open!==null){badge.textContent=open?'✅ 現在營業中':'❌ 現在休息中';badge.className='d-open-badge '+(open?'open':'closed');}
      const todayStr=getTodayHours(det.opening_hours);
      const hbox=document.getElementById('d-hours-box');
      if(hbox&&todayStr){hbox.textContent='🕐 '+todayStr;hbox.style.display='';}
    }
    if(det.photos&&det.photos.length>1){
      dpPhotos=det.photos;
      ['dp-prev','dp-next'].forEach(id=>{const el=document.getElementById(id);if(el)el.style.display='';});
      const cnt=document.getElementById('dp-cnt');if(cnt){cnt.textContent=`1 / ${dpPhotos.length}`;cnt.style.display='';}
    }
    loadReviewsIntoEl(det,document.getElementById('d-reviews'));
  });
}

function loadReviewsIntoEl(det,rvDiv){
  if(!rvDiv)return;
  if(!det.reviews?.length){rvDiv.innerHTML='<div style="font-size:13px;color:var(--text3);font-style:italic">暫無評論</div>';return;}
  const reviews=[...det.reviews].sort((a,b)=>(b.time||0)-(a.time||0));
  const high=reviews.filter(r=>r.rating>=4),low=reviews.filter(r=>r.rating<=2);
  const shown=[...high.slice(0,2),...low.slice(0,1)];const rest=reviews.filter(r=>!shown.includes(r));
  const mkRv=r=>{const stars='★'.repeat(r.rating)+'☆'.repeat(5-r.rating);const txt=(r.text||'').length>180?r.text.slice(0,180)+'…':(r.text||'（無文字評論）');const cls=r.rating>=4?'rv-high':r.rating<=2?'rv-low':'rv-mid';return `<div class="rv-item ${cls}"><div class="rv-meta"><span class="rv-author">${r.author_name}</span><span class="rv-stars">${stars}</span><span class="rv-time">${r.relative_time_description||''}</span></div><div class="rv-text">${txt}</div></div>`;};
  let html=shown.map(mkRv).join('');
  if(rest.length)html+=`<button class="rv-more-btn" id="rv-more">▼ 顯示更多（${rest.length} 則）</button>`;
  rvDiv.innerHTML=html;
  if(rest.length)document.getElementById('rv-more').onclick=function(){this.remove();rest.forEach(r=>rvDiv.insertAdjacentHTML('beforeend',mkRv(r)));};
}

function dpNav(dir){
  if(!dpPhotos||dpPhotos.length<=1)return;
  dpIdx=(dpIdx+dir+dpPhotos.length)%dpPhotos.length;
  const img=document.getElementById('dp-img');
  if(img){img.style.opacity='0';setTimeout(()=>{img.src=dpPhotos[dpIdx].getUrl({maxWidth:800,maxHeight:400});img.style.opacity='1';},250);}
  const cnt=document.getElementById('dp-cnt');if(cnt)cnt.textContent=`${dpIdx+1} / ${dpPhotos.length}`;
}
function closeDetail(){document.getElementById('detailBg').classList.remove('show');}
function copyAddr(){const el=document.getElementById('d-addr');if(!el)return;navigator.clipboard?.writeText(el.textContent).then(()=>{const b=document.querySelector('.d-copy-btn');if(b){b.textContent='✅';setTimeout(()=>{b.textContent='📋';},1500);}}).catch(()=>{});}
function sharePlace(name,url){if(navigator.share){navigator.share({title:name,text:`推薦這間餐廳：${name}`,url}).catch(()=>{});}else{navigator.clipboard?.writeText(url).then(()=>alert('連結已複製！'));}}

// ══ FAVORITES ══
function showFavPanel(){
  const list=document.getElementById('favList'),keys=Object.keys(favorites);
  list.innerHTML=keys.length?keys.map(id=>{const f=favorites[id];const nav=`https://www.google.com/maps/dir/?api=1&destination=${f.lat},${f.lng}`;return `<div class="fav-item"><div class="fav-em">${f.emoji}</div><div class="fav-info"><div class="fav-iname">${f.name}</div><div class="fav-iaddr">${f.vicinity}</div></div><button class="fav-nav" onclick="window.open('${nav}','_blank')">▶ 導航</button></div>`;}).join(''):'<div class="fav-empty">尚無收藏<br>點餐廳卡片左上角可收藏</div>';
  document.getElementById('favPanel').classList.add('show');
}
function hideFavPanel(){document.getElementById('favPanel').classList.remove('show');}
</script>
