<!DOCTYPE html>
<html lang="zh-TW" data-theme="light" data-cuisine="all">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#0c0b09">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="尋味">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<title>尋味</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Noto+Sans+TC:wght@300;400;500&display=swap" rel="stylesheet">
<style>
[data-theme="light"]{
  --bg:#f6f4ef;--bg2:#eceae3;--surface:#fff;--surface2:#f0ede5;--surface3:#e5e1d7;
  --border:rgba(20,16,8,.07);--border-md:rgba(20,16,8,.13);--border-strong:rgba(20,16,8,.22);
  --text:#141008;--text2:#5c5444;--text3:#a09070;--inv:#f6f4ef;
  --ink:#141008;--gold:#8a6508;--gold-l:#faf2dc;--gold-b:#d4aa40;
  --green:#1e5030;--green-l:#e8f4ec;--green-b:#70b888;
  --red:#7a2020;--red-l:#fdf0ee;--red-b:#c07070;
  --blue:#1a3868;--blue-l:#e8f0fc;--blue-b:#7090d0;
  --purple:#42207a;--purple-l:#f0eafc;--purple-b:#9060d8;
  --sh1:0 2px 8px rgba(0,0,0,.07),0 4px 18px rgba(0,0,0,.04);
  --overlay:rgba(8,6,2,.58);
}
[data-theme="dark"]{
  --bg:#0c0b09;--bg2:#141210;--surface:#181612;--surface2:#201e18;--surface3:#282420;
  --border:rgba(255,248,224,.06);--border-md:rgba(255,248,224,.12);--border-strong:rgba(255,248,224,.22);
  --text:#f0ece0;--text2:#a09070;--text3:#5c5038;--inv:#0c0b09;
  --ink:#f0ece0;--gold:#c8a030;--gold-l:#241e08;--gold-b:#6a5010;
  --green:#30784a;--green-l:#0c1a10;--green-b:#1a4028;
  --red:#a84040;--red-l:#1a0c0c;--red-b:#502020;
  --blue:#3860b0;--blue-l:#0c1020;--blue-b:#1a2848;
  --purple:#6840b8;--purple-l:#140c28;--purple-b:#30185c;
  --sh1:0 2px 8px rgba(0,0,0,.4),0 4px 18px rgba(0,0,0,.3);
  --overlay:rgba(0,0,0,.78);
}
[data-cuisine*="japanese"]{--tint:#f3ede0;} [data-theme="dark"][data-cuisine*="japanese"]{--tint:#1a1608;}
[data-cuisine*="western"]{--tint:#eaeff8;} [data-theme="dark"][data-cuisine*="western"]{--tint:#0c1018;}
[data-cuisine*="western_american"]{--tint:#ede8f8;} [data-theme="dark"][data-cuisine*="western_american"]{--tint:#100c1c;}
[data-cuisine*="chinese"]{--tint:#f8edea;} [data-theme="dark"][data-cuisine*="chinese"]{--tint:#1a0c08;}
[data-cuisine*="cafe"]{--tint:#f3e8d8;} [data-theme="dark"][data-cuisine*="cafe"]{--tint:#1a1208;}
[data-cuisine*="korean"]{--tint:#eaf3ec;} [data-theme="dark"][data-cuisine*="korean"]{--tint:#0c180e;}
[data-cuisine*="thai"]{--tint:#f8f3d8;} [data-theme="dark"][data-cuisine*="thai"]{--tint:#181600;}

*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;overflow:hidden;}
body{font-family:'Noto Sans TC',-apple-system,sans-serif;background:var(--tint,var(--bg));color:var(--text);display:flex;flex-direction:column;transition:background .6s;}

/* TOPBAR */
.topbar{background:var(--bg);border-bottom:2px solid var(--ink);padding:calc(10px + env(safe-area-inset-top)) 16px 10px;flex-shrink:0;}
.topbar-inner{display:flex;align-items:flex-end;justify-content:space-between;}
.brand-kicker{font-size:9px;font-weight:500;letter-spacing:.25em;text-transform:uppercase;color:var(--gold);margin-bottom:3px;}
.brand-name{font-family:'Playfair Display',serif;font-size:30px;font-weight:700;letter-spacing:-.5px;color:var(--text);line-height:1;}
.brand-tagline{font-family:'Playfair Display',serif;font-size:11px;font-style:italic;color:var(--text2);margin-top:2px;}
.topbar-r{display:flex;gap:6px;align-items:center;padding-bottom:2px;}
.api-dot{width:7px;height:7px;border-radius:50%;background:var(--border-md);transition:all .4s;}
.api-dot.ok{background:#4ade80;box-shadow:0 0 0 3px rgba(74,222,128,.2);}
.icon-btn{width:34px;height:34px;border-radius:50%;border:1px solid var(--border-md);background:transparent;color:var(--text2);font-size:15px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s;}
.icon-btn:active{transform:scale(.9);}

/* SCROLL */
.scroll-area{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:0 0 calc(86px + env(safe-area-inset-bottom));}

/* FILTER PANEL */
.filter-panel{background:var(--surface);border-bottom:1px solid var(--border-md);padding:14px 16px;}
.fp-row{margin-bottom:13px;}
.fp-row:last-child{margin-bottom:0;}
.fp-label{font-size:9px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--text3);margin-bottom:7px;display:flex;align-items:center;gap:8px;}
.fp-label::after{content:'';flex:1;height:1px;background:var(--border);}

/* CHIPS */
.chips{display:flex;flex-wrap:wrap;gap:5px;}
.chip{height:30px;padding:0 12px;border-radius:2px;border:1px solid var(--border-md);background:transparent;color:var(--text2);font-size:12px;font-family:'Noto Sans TC',sans-serif;cursor:pointer;display:flex;align-items:center;gap:4px;white-space:nowrap;transition:all .15s;letter-spacing:.01em;}
.chip:active{transform:scale(.95);}
.chip.on{background:var(--ink);border-color:var(--ink);color:var(--inv);font-weight:500;}

/* PRICE CHIPS */
.price-chip{height:30px;padding:0 12px;border-radius:2px;border:1px solid var(--border-md);background:transparent;color:var(--text2);font-size:13px;font-family:'Noto Sans TC',sans-serif;cursor:pointer;white-space:nowrap;transition:all .15s;letter-spacing:.05em;}
.price-chip:active{transform:scale(.95);}
.price-chip.on{background:var(--gold-l);border-color:var(--gold-b);color:var(--gold);font-weight:700;}

.divl{border-top:1px solid var(--border);margin:12px 0;}
.sl-row{display:flex;align-items:center;gap:10px;margin-bottom:9px;}
.sl-row label{font-size:12px;color:var(--text2);white-space:nowrap;min-width:52px;}
input[type=range]{flex:1;accent-color:var(--gold);cursor:pointer;}
.sl-val{font-size:13px;font-weight:500;color:var(--gold);min-width:52px;text-align:right;}

.inline-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:8px;}
.inline-row label{font-size:12px;color:var(--text2);white-space:nowrap;}
.mini-btns{display:flex;gap:4px;flex-wrap:wrap;}
.mini-btn{height:26px;padding:0 10px;border-radius:2px;border:1px solid var(--border-md);background:transparent;font-size:11px;color:var(--text2);font-family:'Noto Sans TC',sans-serif;cursor:pointer;transition:all .15s;}
.mini-btn.on{background:var(--gold-l);border-color:var(--gold-b);color:var(--gold);font-weight:600;}
.mini-btn[data-s].on{background:var(--ink);border-color:var(--ink);color:var(--inv);}

/* TOGGLE */
.toggle-row{display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none;}
.toggle-track{width:36px;height:20px;border-radius:10px;background:var(--surface3);border:1px solid var(--border-md);position:relative;transition:background .2s;flex-shrink:0;}
.toggle-track.on{background:var(--green);border-color:var(--green);}
.toggle-thumb{width:14px;height:14px;border-radius:50%;background:#fff;position:absolute;top:2px;left:2px;transition:left .2s;box-shadow:0 1px 3px rgba(0,0,0,.2);}
.toggle-track.on .toggle-thumb{left:18px;}
.toggle-label{font-size:12px;color:var(--text2);}

/* SEARCH BAR */
.search-bar{position:fixed;bottom:0;left:0;right:0;padding:10px 14px calc(10px + env(safe-area-inset-bottom));background:var(--bg);border-top:2px solid var(--ink);z-index:10;}
.btn-search{width:100%;height:48px;background:var(--ink);color:var(--inv);border:none;border-radius:2px;font-size:14px;font-weight:500;font-family:'Playfair Display',serif;letter-spacing:.08em;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:9px;transition:opacity .15s;}
.btn-search:active{opacity:.8;}
.btn-search:disabled{opacity:.38;cursor:not-allowed;}

/* RESULTS */
.results-area{padding:0 14px;}
.sec-hdr{display:flex;align-items:baseline;gap:10px;padding:16px 0 10px;border-bottom:1px solid var(--border);margin-bottom:13px;}
.sec-title{font-family:'Playfair Display',serif;font-size:20px;font-weight:700;color:var(--text);}
.sec-count{font-size:11px;color:var(--text3);font-family:'Noto Sans TC',sans-serif;}
.sec-pill{margin-left:auto;font-size:10px;padding:2px 9px;border-radius:1px;border:1px solid;font-family:'Noto Sans TC',sans-serif;letter-spacing:.05em;}
.sp-gold{background:var(--gold-l);color:var(--gold);border-color:var(--gold-b);}
.sp-purple{background:var(--purple-l);color:var(--purple);border-color:var(--purple-b);}
.sp-green{background:var(--green-l);color:var(--green);border-color:var(--green-b);}

/* SESSION HISTORY STRIP */
.history-strip{padding:12px 14px 0;}
.history-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
.history-title{font-size:11px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--text3);}
.history-clear{font-size:11px;color:var(--red);background:none;border:none;cursor:pointer;font-family:'Noto Sans TC',sans-serif;}
.history-scroll{display:flex;gap:8px;overflow-x:auto;padding-bottom:8px;-webkit-overflow-scrolling:touch;}
.history-scroll::-webkit-scrollbar{display:none;}
.history-card{flex-shrink:0;width:130px;background:var(--surface);border:1px solid var(--border-md);border-radius:2px;padding:9px 10px;cursor:pointer;transition:all .15s;}
.history-card:active{transform:scale(.96);}
.history-card-name{font-size:12px;font-weight:500;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-bottom:3px;}
.history-card-meta{font-size:10px;color:var(--text3);}

/* RESULT CARD */
.r-card{background:var(--surface);border:1px solid var(--border);margin-bottom:13px;cursor:pointer;transition:transform .18s;position:relative;overflow:hidden;box-shadow:var(--sh1);}
.r-card:active{transform:scale(.985);}
.r-photo{position:relative;height:185px;background:var(--surface2);overflow:hidden;}
.r-photo img{width:100%;height:100%;object-fit:cover;display:block;}
.r-photo-grad{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,0) 30%,rgba(0,0,0,.65) 100%);}
.r-score{position:absolute;top:10px;right:10px;background:rgba(0,0,0,.52);backdrop-filter:blur(6px);color:#fff;font-size:14px;font-weight:700;padding:5px 11px;border-radius:1px;font-family:'Playfair Display',serif;display:flex;align-items:center;gap:3px;}
.r-photo-name{position:absolute;bottom:0;left:0;right:0;padding:12px 13px 10px;}
.r-photo-kicker{font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.7);margin-bottom:3px;font-family:'Noto Sans TC',sans-serif;}
.r-photo-title{font-family:'Playfair Display',serif;font-size:18px;font-weight:700;color:#fff;line-height:1.25;}
.r-no-photo{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;color:var(--text3);}
.r-no-photo span{font-size:34px;}
/* select checkbox for spinner */
.r-select{position:absolute;top:10px;left:10px;z-index:3;width:26px;height:26px;border-radius:2px;background:rgba(0,0,0,.42);backdrop-filter:blur(4px);border:1.5px solid rgba(255,255,255,.5);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s;font-size:14px;color:transparent;}
.r-select.checked{background:var(--gold);border-color:var(--gold);color:#fff;}
/* price badge on photo */
.r-price-badge{position:absolute;bottom:10px;right:10px;background:rgba(0,0,0,.48);backdrop-filter:blur(4px);color:#fff;font-size:12px;font-weight:700;padding:3px 8px;border-radius:1px;letter-spacing:.05em;}
/* strip */
.r-strip{padding:10px 12px 12px;border-top:1px solid var(--border);display:grid;grid-template-columns:1fr auto;gap:5px 10px;}
.r-meta{display:flex;flex-wrap:wrap;gap:4px;grid-column:1/-1;}
.pill{font-size:10px;padding:2px 8px;border-radius:1px;border:1px solid;white-space:nowrap;letter-spacing:.02em;}
.pg{background:var(--surface2);border-color:var(--border-md);color:var(--text2);}
.po{background:var(--green-l);border-color:var(--green-b);color:var(--green);}
.pc{background:var(--red-l);border-color:var(--red-b);color:var(--red);}
.pch{background:#fdf0ee;border-color:#c88070;color:#7a2828;}
.pwe{background:var(--blue-l);border-color:var(--blue-b);color:var(--blue);}
.pja{background:var(--purple-l);border-color:var(--purple-b);color:var(--purple);}
.pth{background:#faf5dc;border-color:#c8b840;color:#5a4800;}
.pko{background:#eaf4ec;border-color:#70b080;color:#1a5028;}
.pbr{background:var(--green-l);border-color:var(--green-b);color:var(--green);}
.pca{background:#f8f0e0;border-color:#c09040;color:#604818;}
.pam{background:var(--purple-l);border-color:var(--purple-b);color:var(--purple);}
.pprice{background:var(--gold-l);border-color:var(--gold-b);color:var(--gold);font-weight:600;}
.r-addr{font-size:11px;color:var(--text3);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.r-pk-line{font-size:11px;color:var(--text3);text-align:right;}
.r-hint{font-size:10px;color:var(--text3);letter-spacing:.03em;grid-column:1/-1;text-align:right;}

/* spinner FAB */
.spinner-fab{position:fixed;bottom:calc(72px + env(safe-area-inset-bottom));right:16px;z-index:9;width:48px;height:48px;border-radius:50%;background:var(--gold);border:none;color:#fff;font-size:22px;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(138,101,8,.4);cursor:pointer;transition:all .2s;display:none;}
.spinner-fab.show{display:flex;}
.spinner-fab:active{transform:scale(.9);}
.spinner-fab-count{position:absolute;top:-4px;right:-4px;width:18px;height:18px;border-radius:50%;background:var(--red);color:#fff;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;}

/* MODAL BASE */
.modal-bg{display:none;position:fixed;inset:0;background:var(--overlay);z-index:100;align-items:flex-end;}
.modal-bg.show{display:flex;}
.modal-sheet{background:var(--surface);width:100%;border-top:2px solid var(--ink);padding:16px 18px calc(26px + env(safe-area-inset-bottom));max-height:88vh;overflow-y:auto;}
.m-handle{width:32px;height:3px;background:var(--border-md);border-radius:99px;margin:0 auto 16px;}
.m-title{font-family:'Playfair Display',serif;font-size:20px;font-weight:700;margin-bottom:6px;}
.m-desc{font-size:13px;color:var(--text2);line-height:1.7;margin-bottom:14px;}
.m-desc a{color:var(--gold);}
.m-input{width:100%;height:46px;padding:0 13px;border:1px solid var(--border-md);border-radius:2px;font-size:14px;font-family:monospace;background:var(--surface2);color:var(--text);outline:none;margin-bottom:6px;}
.m-input:focus{border-color:var(--gold);}
.m-status{font-size:12px;color:var(--text3);min-height:18px;margin-bottom:11px;}
.m-btn-p{width:100%;height:48px;background:var(--ink);color:var(--inv);border:none;border-radius:2px;font-size:14px;font-weight:500;font-family:'Noto Sans TC',sans-serif;cursor:pointer;margin-bottom:8px;}
.m-btn-p:active{opacity:.8;}
.m-btn-s{width:100%;height:44px;background:transparent;color:var(--text2);border:1px solid var(--border-md);border-radius:2px;font-size:13px;font-family:'Noto Sans TC',sans-serif;cursor:pointer;}

/* SEARCH HISTORY DROPDOWN */
.search-hist-wrap{position:relative;}
.search-hist-list{position:absolute;top:100%;left:0;right:0;background:var(--surface);border:1px solid var(--border-md);border-top:none;z-index:20;display:none;max-height:180px;overflow-y:auto;}
.search-hist-list.show{display:block;}
.hist-item{display:flex;align-items:center;justify-content:space-between;padding:9px 12px;cursor:pointer;border-bottom:1px solid var(--border);font-size:13px;color:var(--text2);}
.hist-item:last-child{border-bottom:none;}
.hist-item:hover{background:var(--surface2);}
.hist-del{background:none;border:none;color:var(--text3);font-size:14px;cursor:pointer;padding:0 4px;}

/* SPINNER WHEEL MODAL */
.spin-modal{display:none;position:fixed;inset:0;background:var(--overlay);z-index:200;align-items:center;justify-content:center;padding:20px;}
.spin-modal.show{display:flex;}
.spin-box{background:var(--surface);border-top:2px solid var(--ink);width:100%;max-width:400px;padding:20px 20px calc(20px + env(safe-area-inset-bottom));max-height:90vh;overflow-y:auto;}
.spin-title{font-family:'Playfair Display',serif;font-size:22px;font-weight:700;text-align:center;margin-bottom:4px;}
.spin-subtitle{font-size:12px;color:var(--text3);text-align:center;margin-bottom:18px;font-style:italic;}
/* wheel */
.wheel-wrap{position:relative;width:260px;height:260px;margin:0 auto 20px;}
.wheel-canvas{border-radius:50%;display:block;}
.wheel-pointer{position:absolute;top:-14px;left:50%;transform:translateX(-50%);font-size:28px;line-height:1;filter:drop-shadow(0 2px 4px rgba(0,0,0,.3));}
.wheel-center{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:40px;height:40px;border-radius:50%;background:var(--surface);border:3px solid var(--ink);display:flex;align-items:center;justify-content:center;font-size:18px;cursor:pointer;transition:transform .1s;box-shadow:0 2px 8px rgba(0,0,0,.2);}
.wheel-center:active{transform:translate(-50%,-50%) scale(.9);}
/* result */
.spin-result{background:var(--gold-l);border:2px solid var(--gold-b);padding:14px 16px;margin-bottom:14px;text-align:center;display:none;}
.spin-result.show{display:block;}
.spin-result-label{font-size:10px;letter-spacing:.15em;text-transform:uppercase;color:var(--gold);margin-bottom:5px;}
.spin-result-name{font-family:'Playfair Display',serif;font-size:20px;font-weight:700;color:var(--text);margin-bottom:4px;}
.spin-result-meta{font-size:12px;color:var(--text2);}
.spin-result-actions{display:flex;gap:8px;margin-top:10px;}
.spin-act{flex:1;height:38px;border-radius:2px;border:1px solid var(--border-md);background:transparent;font-size:12px;font-weight:500;font-family:'Noto Sans TC',sans-serif;color:var(--text2);cursor:pointer;}
.spin-act.primary{background:var(--ink);color:var(--inv);border-color:var(--ink);}
/* selected list */
.spin-list{margin-bottom:14px;}
.spin-list-title{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--text3);margin-bottom:8px;}
.spin-item{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--border);font-size:13px;}
.spin-item:last-child{border-bottom:none;}
.spin-item-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0;}
.spin-item-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.spin-item-score{font-size:11px;color:var(--text3);}
.spin-close{width:100%;height:44px;background:transparent;border:1px solid var(--border-md);border-radius:2px;font-size:13px;color:var(--text2);font-family:'Noto Sans TC',sans-serif;cursor:pointer;margin-top:4px;}

/* DETAIL SHEET */
.detail-bg{display:none;position:fixed;inset:0;background:var(--overlay);z-index:50;align-items:flex-end;}
.detail-bg.show{display:flex;}
.detail-sheet{background:var(--surface);border-radius:0;width:100%;max-height:94vh;overflow-y:auto;-webkit-overflow-scrolling:touch;border-top:2px solid var(--ink);}
.d-photo-wrap{position:relative;height:250px;background:var(--surface2);overflow:hidden;flex-shrink:0;}
.d-photo-wrap img{width:100%;height:100%;object-fit:cover;display:block;transition:opacity .28s;}
.d-photo-grad{position:absolute;inset:0;background:linear-gradient(to bottom,transparent 50%,rgba(0,0,0,.38) 100%);}
.d-close{position:absolute;top:13px;right:13px;width:30px;height:30px;border-radius:50%;background:rgba(0,0,0,.48);border:none;color:#fff;font-size:16px;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:5;}
.d-arr-wrap{position:absolute;inset:0;display:flex;align-items:center;justify-content:space-between;padding:0 10px;pointer-events:none;}
.d-arr{width:36px;height:36px;border-radius:50%;border:none;background:rgba(0,0,0,.42);color:#fff;font-size:20px;display:flex;align-items:center;justify-content:center;cursor:pointer;pointer-events:all;}
.d-arr:active{background:rgba(0,0,0,.7);}
.d-photo-cnt{position:absolute;bottom:10px;right:13px;background:rgba(0,0,0,.46);color:#fff;font-size:11px;padding:3px 10px;border-radius:99px;}
.d-no-photo{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--text3);gap:8px;}
