<div class="spin-modal" id="spinModal" onclick="if(event.target===this)hideSpinModal()">
  <div class="spin-box">
    <div class="spin-title">今天吃什麼？</div>
    <div class="spin-subtitle">按中間按鈕開始轉</div>
