// ══ SPINNER WHEEL ══
const WHEEL_COLORS=['#8a6508','#2a6a40','#6840b8','#1a3868','#7a2020','#30784a','#42207a','#1e5030','#8a4000','#1a5030'];

function drawWheel(angle){
  const canvas=document.getElementById('wheelCanvas');if(!canvas)return;
  const ctx=canvas.getContext('2d');
  const cx=130,cy=130,r=120,items=[...spinSelected.values()];
  if(!items.length)return;
  const slice=(2*Math.PI)/items.length;
  ctx.clearRect(0,0,260,260);
  items.forEach((item,i)=>{
    const start=angle+i*slice,end=start+slice;
    ctx.beginPath();ctx.moveTo(cx,cy);ctx.arc(cx,cy,r,start,end);ctx.closePath();
    ctx.fillStyle=WHEEL_COLORS[i%WHEEL_COLORS.length];ctx.fill();
    ctx.strokeStyle='rgba(255,255,255,.3)';ctx.lineWidth=1;ctx.stroke();
    // label
    ctx.save();ctx.translate(cx,cy);ctx.rotate(start+slice/2);
    ctx.textAlign='right';ctx.fillStyle='#fff';
    ctx.font=`500 ${items.length>6?'10':'12'}px Noto Sans TC,sans-serif`;
    const label=item.name.length>8?item.name.slice(0,7)+'…':item.name;
    ctx.fillText(label,r-8,4);ctx.restore();
  });
  // center
  ctx.beginPath();ctx.arc(cx,cy,20,0,2*Math.PI);ctx.fillStyle='var(--surface)';ctx.fill();
}

function showSpinModal(){
