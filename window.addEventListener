.pk-nav-btn:active{opacity:.75;}
.rv-item{padding:10px 12px;margin-bottom:6px;border-left:3px solid;}
.rv-high{background:var(--green-l);border-color:var(--green);}
.rv-low{background:var(--red-l);border-color:var(--red);}
.rv-mid{background:var(--surface2);border-color:var(--border-md);}
.rv-meta{display:flex;align-items:center;gap:5px;margin-bottom:3px;flex-wrap:wrap;}
.rv-author{font-size:12px;font-weight:500;}
.rv-stars{font-size:11px;color:var(--gold);}
.rv-time{font-size:11px;color:var(--text3);}
.rv-text{font-size:12px;color:var(--text2);line-height:1.65;}
.rv-more-btn{background:none;border:none;color:var(--gold);font-size:13px;cursor:pointer;padding:5px 0;font-family:'Noto Sans TC',sans-serif;}
.d-actions{display:flex;gap:8px;margin-top:13px;}
.d-act{flex:1;height:46px;border-radius:2px;border:1px solid var(--border-strong);background:transparent;font-size:13px;font-weight:500;font-family:'Noto Sans TC',sans-serif;color:var(--text2);cursor:pointer;display:flex;align-items:center;justify-content:center;gap:4px;}
