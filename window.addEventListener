// ══ HELPERS ══
function mDist(la1,lo1,la2,lo2){const R=6371000,dL=(la2-la1)*Math.PI/180,dN=(lo2-lo1)*Math.PI/180;const a=Math.sin(dL/2)**2+Math.cos(la1*Math.PI/180)*Math.cos(la2*Math.PI/180)*Math.sin(dN/2)**2;return Math.round(R*2*Math.atan2(Math.sqrt(a),Math.sqrt(1-a)));}
function fmtDist(m){return m>=1000?(m/1000).toFixed(1)+'km':m+'m';}
function cuisineOf(name,types){
  const s=((name||'')+(types||[]).join(' ')).toLowerCase();
  if(/漢堡|美式|burger|diner|bbq|炸雞|wings|american/.test(s))return 'western_american';
  if(/中式|粥|燒臘|滷肉|豆漿|饅頭|飯糰|蛋餅|包子|米粉|麵線|炒飯|chinese|台式|小籠|牛肉麵|涼麵|鹹酥|熱炒|便當|滷味/.test(s))return 'chinese';
  if(/西式|三明治|吐司|鬆餅|貝果|western|sandwich|pizza|pasta|bistro|歐式/.test(s))return 'western';
  if(/日式|壽司|拉麵|丼|定食|japanese|sushi|ramen|udon|居酒屋/.test(s))return 'japanese';
  if(/泰式|打拋|泰國|thai/.test(s))return 'thai';
  if(/韓式|韓國|korean|部隊鍋|石鍋|烤肉/.test(s))return 'korean';
  if(/咖啡|coffee|cafe|caf[eé]|拿鐵|手沖|烘焙/.test(s))return 'cafe';
  if(/早午餐|brunch/.test(s))return 'brunch';
  return 'other';
}
function matchCuisine(n,t){if(selCuisines.size===0)return true;return selCuisines.has(cuisineOf(n,t));}
function matchPrice(p){if(selPrices.size===0)return true;if(p==null)return true;return selPrices.has(p);}
function nearestPark(parks,pLat,pLng){let best=null,bd=Infinity;(parks||[]).forEach(pk=>{const d=mDist(pLat,pLng,pk.geometry.location.lat(),pk.geometry.location.lng());if(d<bd){bd=d;best=pk;}});return best?{name:best.name,dist:bd,placeId:best.place_id,vicinity:best.vicinity||'',rating:best.rating,lat:best.geometry.location.lat(),lng:best.geometry.location.lng()}:null;}

// ══ OPEN NOW (periods-based, timezone correct) ══
function isOpenNow(oh){
  if(!oh)return null;
  try{
    if(oh.periods){
      const now=new Date(),day=now.getDay(),hhmm=now.getHours()*100+now.getMinutes();
      for(const p of oh.periods){
        if(p.open&&!p.close)return true;
        if(!p.open||!p.close)continue;
        const od=p.open.day,ot=parseInt(p.open.time||'0000'),cd=p.close.day,ct=parseInt(p.close.time||'0000');
        if(od===cd){if(day===od&&hhmm>=ot&&hhmm<ct)return true;}
        else{if(day===od&&hhmm>=ot)return true;if(day===cd&&hhmm<ct)return true;}
      }
      return false;
    }
    return oh.isOpen();
  }catch(e){return null;}
}
function getTodayHours(oh){
  if(!oh||!oh.weekday_text)return null;
  const gwDay=(new Date().getDay()+6)%7;
  return oh.weekday_text[gwDay]||null;
}

// ══ SEARCH ══
function buildKws(){
  const tk=selTypes.size>0?[...selTypes].flatMap(t=>(TKW[t]||'').split(' ').filter(Boolean)):(TKW['all']||'').split(' ').filter(Boolean);
  const ck=selCuisines.size>0?[...selCuisines].flatMap(c=>(CKW[c]||'').split(' ').filter(Boolean)):[];
  if(ck.length>0){const co=[];ck.forEach(c=>tk.slice(0,2).forEach(t=>co.push(c+' '+t)));ck.forEach(c=>co.push(c));return[...new Set(co)].slice(0,8);}
  return[...new Set(tk)].slice(0,6);
}
function srchKw(lat,lng,kw,radius){
  return new Promise(res=>{
    placesService.nearbySearch({location:new google.maps.LatLng(lat,lng),rankBy:google.maps.places.RankBy.DISTANCE,type:'restaurant',keyword:kw,language:'zh-TW'},(r,st)=>{
      if(st==='OK'||st==='ZERO_RESULTS'){res((r||[]).filter(p=>{const d=mDist(lat,lng,p.geometry.location.lat(),p.geometry.location.lng());p._dist=d;return d<=radius&&(!minRating||(p.rating||0)>=minRating)&&matchPrice(p.price_level);}));}
      else res([]);
    });
  });
}
function srchFeat(lat,lng,kw,radius){
  return new Promise(res=>{
    placesService.nearbySearch({location:new google.maps.LatLng(lat,lng),rankBy:google.maps.places.RankBy.DISTANCE,type:'restaurant',keyword:kw,language:'zh-TW'},(r,st)=>{
      if(st==='OK'){res((r||[]).filter(p=>{const d=mDist(lat,lng,p.geometry.location.lat(),p.geometry.location.lng());p._dist=d;return d>radius&&d<=radius*3&&(p.rating||0)>=4.5&&matchPrice(p.price_level);}));}
      else res([]);
    });
  });
}
function srchParks(lat,lng,radius){return new Promise(res=>{placesService.nearbySearch({location:new google.maps.LatLng(lat,lng),radius:Math.min(radius+1500,50000),type:'parking',language:'zh-TW'},r=>res(r||[]));});}

async function doSearch(){
  if(!mapsLoaded){showApiModal();return;}
  const locVal=document.getElementById('locationInput').value.trim();
  const div=document.getElementById('results'),btn=document.getElementById('searchBtn');
  btn.disabled=true;
  div.innerHTML=`<div class="loading"><div class="spinner-el"></div>搜尋中...<div class="search-note">多關鍵字搜尋，稍候片刻</div></div>`;

  const go=async(lat,lng)=>{
    currentLat=lat;currentLng=lng;
    localStorage.setItem('last_lat',lat);localStorage.setItem('last_lng',lng);
    const kws=buildKws();const seen=new Set(),inside=[];
    for(let i=0;i<kws.length;i+=3){
      const b=kws.slice(i,i+3);
      const rs=await Promise.all(b.map(k=>srchKw(lat,lng,k,searchRadius)));
      rs.forEach(l=>l.forEach(p=>{if(!seen.has(p.place_id)){seen.add(p.place_id);inside.push(p);}}));
    }
    const frs=await Promise.all(kws.slice(0,3).map(k=>srchFeat(lat,lng,k,searchRadius)));
    const fseen=new Set([...seen]),featured=[];
    frs.forEach(l=>l.forEach(p=>{if(!fseen.has(p.place_id)&&matchCuisine(p.name,p.types)){fseen.add(p.place_id);featured.push(p);}}));
    let filtered=selCuisines.size>0?inside.filter(p=>matchCuisine(p.name,p.types)):inside;
    filtered.sort((a,b)=>sortMode==='rating'?(b.rating||0)-(a.rating||0):sortMode==='reviews'?(b.user_ratings_total||0)-(a.user_ratings_total||0):a._dist-b._dist);
    featured.sort((a,b)=>(b.rating||0)-(a.rating||0));
    const parks=await srchParks(lat,lng,searchRadius);
    renderResults(filtered,featured.slice(0,5),parks,div);
    btn.disabled=false;
  };

  if(locVal){
    geocoder.geocode({address:locVal,language:'zh-TW'},(res,st)=>{
      if(st==='OK'&&res[0]){addSearchHist(locVal);go(res[0].geometry.location.lat(),res[0].geometry.location.lng());}
      else{div.innerHTML=`<div class="empty"><span class="empty-icon">📍</span>找不到此地址<small>請重新輸入</small></div>`;btn.disabled=false;}
    });
  }else if(currentLat){go(currentLat,currentLng);}
  else{div.innerHTML=`<div class="empty"><span class="empty-icon">📍</span>請輸入地址或點「定位」</div>`;btn.disabled=false;}
}

