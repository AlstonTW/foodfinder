.d-copy-btn{background:none;border:none;color:var(--text3);font-size:14px;cursor:pointer;padding:2px;flex-shrink:0;}
.d-action-row{display:flex;gap:7px;margin-bottom:6px;}
.d-sm-btn{flex:1;height:36px;border-radius:2px;border:1px solid var(--border-md);background:transparent;font-size:12px;font-weight:500;font-family:'Noto Sans TC',sans-serif;color:var(--text2);cursor:pointer;display:flex;align-items:center;justify-content:center;gap:4px;}
