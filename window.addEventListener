      <div class="spin-result-actions">
        <button class="spin-act" onclick="spinAgain()">再轉一次</button>
        <button class="spin-act primary" id="spinNavBtn">▶ 導航前往</button>
      </div>
    </div>
    <div class="spin-list">
      <div class="spin-list-title">已選餐廳</div>
      <div id="spinListItems"></div>
    </div>
    <button class="spin-close" onclick="hideSpinModal()">關閉</button>
  </div>
</div>

<div id="map"></div>

<script>
// ══ STATE ══
let placesService,geocoder,mapsLoaded=false;
let currentLat=null,currentLng=null;
let minRating=3.5,searchRadius=1000,sortMode='dist',openOnly=false;
let selTypes=new Set(),selCuisines=new Set(),selPrices=new Set();
let dpPhotos=[],dpIdx=0;
let favorites=JSON.parse(localStorage.getItem('fav7')||'{}');
let searchHistory=JSON.parse(localStorage.getItem('searchHist')||'[]');
let sessionHistory=[]; // cleared on page load
let spinSelected=new Map(); // placeId -> place data
let spinAngle=0,spinning=false,animFrame=null;

// ══ CUISINE / PRICE DATA ══
const C={
  chinese:{label:'中式',cls:'pch',emoji:'🥢'},western:{label:'西式',cls:'pwe',emoji:'🍳'},
  western_american:{label:'美式',cls:'pam',emoji:'🍔'},japanese:{label:'日式',cls:'pja',emoji:'🍱'},
  thai:{label:'泰式',cls:'pth',emoji:'🌶'},korean:{label:'韓式',cls:'pko',emoji:'🥘'},
  brunch:{label:'早午餐',cls:'pbr',emoji:'☀️'},cafe:{label:'咖啡廳',cls:'pca',emoji:'☕'},
  other:{label:'其他',cls:'pg',emoji:'🍽'},
};
const PRICE_LABEL={1:'$',2:'$$',3:'$$$',4:'$$$$'};
const PRICE_TEXT={1:'平價',2:'中價',3:'較貴',4:'高級'};
const TKW={all:'餐廳 小吃 食堂',breakfast:'早餐 豆漿 蛋餅 燒餅',brunch:'早午餐 brunch',lunch:'午餐 定食 便當 快炒',afternoon:'下午茶 甜點 蛋糕',cafe:'咖啡廳 coffee cafe 手搖飲',dinner:'晚餐 熱炒 火鍋 餐廳',supper:'消夜 宵夜 鹹酥雞 滷味'};
const CKW={chinese:'中式 台灣 小吃 牛肉麵 滷肉飯 炒飯',western:'西式 義大利 pizza pasta',western_american:'美式 漢堡 burger 炸雞',japanese:'日式 壽司 拉麵 丼 定食',thai:'泰式 打拋 泰國料理',korean:'韓式 烤肉 部隊鍋',cafe:'咖啡 coffee cafe'};

// ══ INIT ══
window.addEventListener('load',()=>{
  if('serviceWorker'in navigator)navigator.serviceWorker.register('/foodfinder/sw.js').catch(()=>{});
  applyTheme(localStorage.getItem('theme')||'light');
  const key='AIzaSyCdmJtX_Zu7-BDaprryXeWiRslfjKxFbjw';
  localStorage.setItem('gmaps_key',key);
  document.getElementById('apiKeyInput').value=key;
  loadSDK(key);
  const loc=localStorage.getItem('last_loc');
  if(loc)document.getElementById('locationInput').value=loc;
  const la=localStorage.getItem('last_lat'),lo=localStorage.getItem('last_lng');
  if(la&&lo){currentLat=parseFloat(la);currentLng=parseFloat(lo);}
  document.querySelector('#typeChips .chip[data-v="all"]').classList.add('on');
  document.querySelector('#cuisineChips .chip[data-v="all"]').classList.add('on');
  document.querySelector('.price-chip[data-p="-1"]').classList.add('on');
});

// ══ THEME ══
function applyTheme(t){document.documentElement.setAttribute('data-theme',t);localStorage.setItem('theme',t);document.getElementById('themeBtn').textContent=t==='dark'?'☀️':'🌙';}
function toggleTheme(){applyTheme(document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark');}

// ══ CONTROLS ══
function updateRadius(v){searchRadius=parseInt(v);document.getElementById('rv').textContent=v>=1000?(v/1000).toFixed(1)+' km':v+' m';}
function setSort(el){sortMode=el.dataset.s;document.querySelectorAll('[data-s]').forEach(b=>b.classList.remove('on'));el.classList.add('on');}
function setRating(val,el){minRating=val;document.querySelectorAll('.mini-btn:not([data-s])').forEach(b=>b.classList.remove('on'));el.classList.add('on');}
function toggleOpenOnly(){openOnly=!openOnly;const t=document.getElementById('openToggle');openOnly?t.classList.add('on'):t.classList.remove('on');}

function toggleChip(el,group){
  const v=el.dataset.v,set=group==='type'?selTypes:selCuisines,pid=group==='type'?'typeChips':'cuisineChips';
  if(v==='all'){set.clear();document.querySelectorAll(`#${pid} .chip`).forEach(b=>b.classList.remove('on'));el.classList.add('on');if(group==='cuisine')document.documentElement.setAttribute('data-cuisine','all');return;}
  document.querySelector(`#${pid} .chip[data-v="all"]`).classList.remove('on');
  if(set.has(v)){set.delete(v);el.classList.remove('on');}else{set.add(v);el.classList.add('on');}
  if(set.size===0){document.querySelector(`#${pid} .chip[data-v="all"]`).classList.add('on');if(group==='cuisine')document.documentElement.setAttribute('data-cuisine','all');}
  else if(group==='cuisine')document.documentElement.setAttribute('data-cuisine',[...selCuisines].join(' '));
}

function togglePrice(el){
  const p=parseInt(el.dataset.p);
  if(p===-1){selPrices.clear();document.querySelectorAll('.price-chip').forEach(b=>b.classList.remove('on'));el.classList.add('on');return;}
  document.querySelector('.price-chip[data-p="-1"]').classList.remove('on');
  if(selPrices.has(p)){selPrices.delete(p);el.classList.remove('on');}else{selPrices.add(p);el.classList.add('on');}
  if(selPrices.size===0)document.querySelector('.price-chip[data-p="-1"]').classList.add('on');
}

// ══ API ══
function showApiModal(){document.getElementById('apiModal').classList.add('show');}
function hideApiModal(){document.getElementById('apiModal').classList.remove('show');}
function saveAndLoad(){
  const key=document.getElementById('apiKeyInput').value.trim();
  if(!key){document.getElementById('apiStatus').textContent='請輸入 API Key';return;}
  localStorage.setItem('gmaps_key',key);document.getElementById('apiStatus').textContent='載入中...';loadSDK(key);
}
function loadSDK(key){
  if(mapsLoaded){hideApiModal();return;}
  const s=document.createElement('script');
  s.src=`https://maps.googleapis.com/maps/api/js?key=${key}&libraries=places&language=zh-TW&callback=initMaps`;
  s.onerror=()=>{document.getElementById('apiStatus').textContent='❌ 載入失敗';};
  document.head.appendChild(s);
}
window.initMaps=function(){
  const map=new google.maps.Map(document.getElementById('map'),{center:{lat:25.033,lng:121.565},zoom:15});
  placesService=new google.maps.places.PlacesService(map);
  geocoder=new google.maps.Geocoder();
  mapsLoaded=true;
  document.getElementById('apiDot').classList.add('ok');
  document.getElementById('apiStatus').textContent='✅ 載入成功';
